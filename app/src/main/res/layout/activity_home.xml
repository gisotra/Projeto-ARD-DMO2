<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".ui.HomeActivity">

    <ImageView
        android:id="@+id/imgUserProfileHome"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_launcher_foreground"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/txtUserNameHome"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="Carregando perfil..."
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@id/imgUserProfileHome"
        app:layout_constraintBottom_toBottomOf="@id/imgUserProfileHome"
        app:layout_constraintStart_toEndOf="@id/imgUserProfileHome"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/edtBuscaCidade"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Buscar postagens por cidade..."
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/imgUserProfileHome"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnBuscar"
        android:layout_marginEnd="8dp"/>

    <Button
        android:id="@+id/btnBuscar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Buscar"
        app:layout_constraintTop_toTopOf="@id/edtBuscaCidade"
        app:layout_constraintBottom_toBottomOf="@id/edtBuscaCidade"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- A LISTA AGORA VAI ATÉ O BLOCO DE PAGINAÇÃO -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPosts"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/edtBuscaCidade"
        app:layout_constraintBottom_toTopOf="@id/layoutPaginacao"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- BLOCO DE PAGINAÇÃO (NOVO) -->
    <LinearLayout
        android:id="@+id/layoutPaginacao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/btnNovoPost"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnAnterior"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="&lt;"
            android:enabled="false"
            style="?attr/materialButtonOutlinedStyle"/>

        <TextView
            android:id="@+id/txtPaginaAtual"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Página 1"
            android:layout_marginHorizontal="24dp"
            android:textStyle="bold"
            android:textSize="16sp"/>

        <Button
            android:id="@+id/btnProximo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="&gt;"
            android:enabled="false"
            style="?attr/materialButtonOutlinedStyle"/>
    </LinearLayout>

    <Button
        android:id="@+id/btnNovoPost"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="+ Novo Post"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnPerfil"
        android:layout_marginEnd="8dp"/>

    <Button
        android:id="@+id/btnPerfil"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Meu Perfil"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnNovoPost"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>